# ─── Database (Supabase) ──────────────────────────────────────────────────
#
# Go to: Supabase Dashboard → Project → Settings → Database → Connection string
#
# DATABASE_URL  → use the "Transaction pooler" URI  (port 6543)
#   It looks like: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# DIRECT_URL    → use the "Session pooler" or "Direct connection" URI  (port 5432)
#   It looks like: postgresql://postgres.xxxx:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
#
# Both URLs live under:  Settings → Database → Connection string → URI tab
# Make sure to replace [YOUR-PASSWORD] with your actual DB password.

DATABASE_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ─── Auth JWT Secret (generate with: openssl rand -base64 32) ─────────────
JWT_SECRET="your-super-secret-key-change-this-in-production"

# ─── Seed protection ──────────────────────────────────────────────────────
SEED_SECRET="your-seed-secret"

# ─── App URL ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
